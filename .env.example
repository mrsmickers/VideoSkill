# Copy this file to .env (or .env.local) and fill in your own values, then:
#   set -a; source .env; set +a
# Transcription is fully local (parakeet-mlx) — no API key needed to ingest.
# These vars are only needed for publishing frames (Notion or R2).

# === Optional — only for scripts/upload-frames-to-notion.py ===
# Recommended path for both public AND private SOPs. Frames go into your Notion
# workspace's private file storage (only accessible to authenticated members).
# Create an internal integration at https://www.notion.so/profile/integrations,
# share the target page with it, and paste the secret here (starts with ntn_ or secret_).
VIDEOSKILL_NOTION_API_KEY=
# Default parent page for /publish-sop pages (the page's UUID from its URL).
# Must be shared with the integration above.
VIDEOSKILL_NOTION_PARENT_ID=

# === Optional — only for scripts/upload-frames-to-r2.py ===
# Use this if you want frames at PUBLIC URLs (embeddable anywhere, not just Notion).
# Only suitable for ingesting public videos — the URLs are accessible to anyone.
# Create an R2 bucket in your Cloudflare account, enable r2.dev managed public
# domain (or attach a custom domain), then create an R2 API token with read+write
# on that bucket — the token gives you the access key ID and secret access key.
VIDEOSKILL_R2_ACCOUNT_ID=
VIDEOSKILL_R2_BUCKET=
VIDEOSKILL_R2_PUBLIC_DOMAIN=
VIDEOSKILL_R2_ACCESS_KEY_ID=
VIDEOSKILL_R2_SECRET_ACCESS_KEY=
